# Copy to .env. .env is gitignored. Do not put real keys in this file.
# Existing environment variables win over values in .env.

# Structured log verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# Used when the variable is unset: INFO.
LOG_LEVEL=INFO

# Stretch phase only. The model client is not a dependency in Phase 0a.
# Leave this blank until Phase S.
ANTHROPIC_API_KEY=
